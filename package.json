{
  "name": "plataforma-quantica",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @plataforma/api prisma migrate dev",
    "db:push": "pnpm --filter @plataforma/api prisma db push",
    "db:seed": "pnpm --filter @plataforma/api seed",
    "db:studio": "pnpm --filter @plataforma/api prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
